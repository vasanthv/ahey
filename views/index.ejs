<!DOCTYPE html>
<html lang="en">
<%- include('head'); -%>

<body>
  <div class="wrap">
    <%- include('header'); -%>
    <h1>Ahey - a free video call app for the web.</h1>
    <div class="row">
      <p>
        Ahey is a frictionless, peer-to-peer video conferencing app you can use right in your browser - no sign-ups,
        no downloads, no limits.
      </p>
      <p>
        Just share your room URL with friends and connect instantly. 100% free, embeddable on any webpage, and
        ready to use.
      </p>
    </div>

    <div class="row">
      <div id="roombox" class="flex">
        <span class="domain">ahey.net/</span>
        <input type="text" placeholder="room-id" class="flex-1" />
        <button onClick="onJoin()">Start</button>
      </div>
      <div class="small light">Entering a room ID is optional - click "Start" to generate a random room.</div>
    </div>

    <script type="text/javascript">
      const inputElement = document.querySelector("#roombox input");

      function onJoin() {
        let roomId = document.querySelector("#roombox input").value;
        if (!roomId) roomId = Math.random().toString(36).substr(2, 6);

        window.location.pathname = roomId;
      }

      inputElement.addEventListener("keypress", function(e) {
        if (e.key === "Enter") {
          e.preventDefault();
          onJoin();
        }
      });

      (() => {
        if ("serviceWorker" in navigator) {
          navigator.serviceWorker.register("/sw.js");
        }
      })();
    </script>

    <%- include('footer'); -%>
  </div>
</body>

</html>